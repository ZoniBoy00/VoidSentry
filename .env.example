DISCORD_TOKEN=YOUR_TOKEN_HERE
CLIENT_ID=YOUR_BOT_CLIENT_ID_HERE
OWNER_ID=YOUR_DISCORD_USER_ID_HERE
GUILD_ID=YOUR_DEV_GUILD_ID_HERE
# Optional: global trap channels. Normally leave empty and use /setup-trap on each server.
BAN_CHANNEL_IDS=
# Optional default log channel (per-server: /trap-settings log-channel)
LOG_CHANNEL_ID=
STATUS_TEXT=Watching for breaches...
DELETE_MESSAGE_SECONDS=86400
# Days to keep captured message content in the ban history (0 = forever)
MESSAGE_RETENTION_DAYS=90
BAN_REASON=Security Breach: Sent a message in a Bot Detection Channel.
NODE_ENV=production

# Optional: read-only stats endpoint for the website (0/empty = disabled).
# Listens on localhost only unless STATS_HOST is changed; put a tunnel or reverse proxy in front of it.
STATS_PORT=0
STATS_HOST=127.0.0.1
# If set, requests must send "Authorization: Bearer <token>"
STATS_TOKEN=
# Only while rotating STATS_TOKEN: the old token, still accepted. Empty it once the website uses the new one.
STATS_TOKEN_PREVIOUS=
# With STATS_TOKEN set, the API for the hosted web dashboard is served under /api/. Self-hosted bots that
# do not use that dashboard can set this to false to serve only /stats.
DASHBOARD_API=true

# Backups (npm run backup). With BACKUP_KEY set, backups are encrypted; keep the key somewhere
# other than the backups themselves (a password manager), or they cannot be restored.
BACKUP_DIR=backups
BACKUP_KEEP=14
BACKUP_KEY=
# Optional second folder that gets a copy of every backup, e.g. one synced to another machine.
BACKUP_COPY_DIR=

# MySQL Database Configuration
DB_HOST=your_mysql_host
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=YOUR_PASSWORD_HERE
DB_NAME=your_database_name